# ═══════════════════════════════════════════════════
# Environment Variables - Copy this to .env
# ═══════════════════════════════════════════════════

# ── OpenAI (REQUIRED for Whisper STT + GPT-4 Doctor + TTS) ──────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ── Azure Speech (RECOMMENDED for best Urdu + Sindhi TTS) ───────
# Get from: https://portal.azure.com → Cognitive Services → Speech
# Free tier available (5 hours/month)
AZURE_SPEECH_KEY=your-azure-key-here
AZURE_SPEECH_REGION=eastus

# ── Google Cloud (Alternative for Urdu STT/TTS) ─────────────────
# Get from: https://console.cloud.google.com
# GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json

# ── ElevenLabs (Premium multilingual TTS) ───────────────────────
# Get from: https://elevenlabs.io
# ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ── Alibaba Cloud / DashScope (Qwen LLM + TTS + STT) ──────────────────
# Get from: https://dashscope.console.aliyun.com (China)
#           https://www.alibabacloud.com/product/model-studio (International)
# Free tier available!
# DASHSCOPE_API_KEY=your-dashscope-key-here
# DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# ── Ollama (LOCAL Qwen - 100% FREE Forever, No API Key!) ─────────────────
# Download Ollama: https://ollama.com
# Then run: ollama pull qwen3:8b
# No API key needed! Runs on your own computer.
# OLLAMA_BASE_URL=http://localhost:11434/v1
